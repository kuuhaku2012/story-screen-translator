<Window x:Class="StoryTranslator.App.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowsTransparency="True" Background="#55000000"
        Cursor="Cross" WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseLeftButtonUp"
        KeyDown="Window_KeyDown">
    <Canvas>
        <TextBlock Canvas.Left="24" Canvas.Top="20" Foreground="White" FontSize="18"
                   Text="Kéo để chọn vùng hội thoại · Esc để hủy" />
        <Rectangle x:Name="SelectionOutline" Visibility="Collapsed" Stroke="#FF53D8FB"
                   StrokeThickness="2" Fill="#3353D8FB" IsHitTestVisible="False" />
    </Canvas>
</Window>
